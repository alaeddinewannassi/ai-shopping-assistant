# Tenancy/admin/analytics database — shared with chatbot/backend/ (see
# ../../tenancy-db), but this service is the one that writes to it (tenant CRUD,
# adapter/LLM config, promo rules, widget keys, admin users/roles).
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Symmetric key used to encrypt tenant-owned secrets at rest (store API keys, per-tenant LLM
# API keys) — must be the SAME value chatbot/backend/ uses, since both decrypt the same
# tenant_adapter_config/tenant_llm_config rows. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# JWT signing secret for admin sessions (T502) — distinct from APP_ENCRYPTION_KEY, never
# reused across purposes. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-random-secret

# Comma-separated list of origins allowed to call this API (the backoffice/frontend/ SPA's
# deployed origin(s)) — no wildcard, unlike chatbot/backend/'s public widget-facing CORS.
ADMIN_CORS_ORIGINS=http://localhost:5173
