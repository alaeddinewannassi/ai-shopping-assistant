# PrestaShop store connection (see quickstart.md step 2)
PRESTASHOP_BASE_URL=http://localhost:8080/api
PRESTASHOP_API_KEY=changeme
PRESTASHOP_LANG_ID=1

# Checkout requires a pre-existing demo customer/address/carrier — PrestaShop's webservice
# has no anonymous-checkout shortcut for order creation. Create these once in PrestaShop
# Admin (or via the webservice) against the reference store and paste their ids here.
PRESTASHOP_DEFAULT_CUSTOMER_ID=
PRESTASHOP_DEFAULT_ADDRESS_ID=
PRESTASHOP_DEFAULT_CARRIER_ID=
PRESTASHOP_DEFAULT_CURRENCY_ID=1
# A default PrestaShop order state id (e.g. "1" = Awaiting check payment on a stock install)
PRESTASHOP_DEFAULT_ORDER_STATE_ID=1
# Any payment module bundled with a stock PrestaShop install works for the demo store
PRESTASHOP_PAYMENT_MODULE=ps_wirepayment
PRESTASHOP_PAYMENT_LABEL=Bank wire

# Session/pending-action/cache backing store
REDIS_URL=redis://localhost:6379/0

# LLM provider — see specs/001-ai-shopping-assistant/research.md §3a
# Supported values: free-tier-hosted (default) | rule-based-stub | hosted-paid
# NOTE: a local/Ollama provider was deliberately evaluated and rejected for this project
# (see research.md §3a "Alternatives considered") — not supported here.
LLM_PROVIDER=free-tier-hosted
LLM_API_KEY=your-free-groq-api-key-here
# Optional: override the default model for the chosen provider
LLM_MODEL=llama-3.3-70b-versatile
# Optional: HTTP timeout for a single Groq call (seconds) — a chat turn falls back to a
# safe search_products default rather than hanging if this is exceeded (llm_client.py)
LLM_TIMEOUT_SECONDS=8

# Taxonomy/catalog snapshot cache TTLs (seconds) — research.md §8, §9
CATALOG_SNAPSHOT_TTL_SECONDS=180
TAXONOMY_SNAPSHOT_TTL_SECONDS=300

# Circuit breaker tuning — research.md §8
ADAPTER_TIMEOUT_SECONDS=5
ADAPTER_FAILURE_THRESHOLD=3
ADAPTER_RECOVERY_SECONDS=30

# --- Multi-tenant backoffice & analytics (specs/002-backoffice-analytics) ---

# Tenancy/admin/analytics database. Unset -> the tenancy tables, admin API, and durable
# analytics event storage are simply unavailable; PRESTASHOP_*/LLM_* above keep working
# exactly as before (single-tenant mode, default tenant, in-memory/Redis session state
# only) — see ../../tenancy-db's engine.py is_configured()/check_health().
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Symmetric key used to encrypt tenant-owned secrets at rest (store API keys, per-tenant LLM
# API keys) in tenant_adapter_config/tenant_llm_config — never store these in plaintext.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# Slug of the tenant a request resolves to when no X-Assistant-Key header is sent — keeps
# today's single-tenant deployment (and the existing widget embed) working unchanged while
# T201-T203 land (plan.md D2).
DEFAULT_TENANT_SLUG=default
