# Compose-level overrides (docker compose auto-loads a .env file next to docker-compose.yml).
# Copy to docker/.env and adjust if needed — all have working defaults in docker-compose.yml.

MYSQL_ROOT_PASSWORD=prestashop_root
MYSQL_DATABASE=prestashop
MYSQL_USER=prestashop
MYSQL_PASSWORD=prestashop

# Must match the host/port you'll browse to (see docker/prestashop/README.md)
PS_DOMAIN=localhost:8080
PS_ADMIN_EMAIL=demo@example.com
PS_ADMIN_PASSWORD=AssistantDemo123!
