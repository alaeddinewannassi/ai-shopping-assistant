{
  "name": "ai-shopping-assistant-widget",
  "version": "0.1.0",
  "description": "Minimal embeddable chat widget for the AI Shopping Assistant (a single <assistant-chat-widget> custom element).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "jsdom": "^25.0.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "prettier": "^3.3.3"
  }
}
